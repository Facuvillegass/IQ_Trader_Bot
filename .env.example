# ============================================================
# MNQ Paper Trading / Forward Test — Environment
# ============================================================
# Copy to .env locally. On Railway, set these as Variables.
# NEVER commit secrets.

# HARD LOCK — do not set to LIVE. Live trading is intentionally unimplemented.
TRADING_MODE=PAPER

# Data provider: mock | databento | yfinance | replay
# mock      = synthetic 1m bars (local / smoke test)
# databento = CME Globex historical + live (recommended for real forward test)
# yfinance  = delayed continuous MNQ=F (limited 1m history)
# replay    = replay CSV bars from data/raw/mnq_1m.csv
DATA_PROVIDER=mock

# Market data API key (Databento). Either name works.
DATABENTO_API_KEY=
DATA_API_KEY=

# Optional Tradovate demo (NOT used for live orders; reserved for future)
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_CLIENT_ID=
TRADOVATE_CLIENT_SECRET=
TRADOVATE_ACCOUNT_ID=

# Account / strategy (FROZEN — do not change for the experiment)
INITIAL_BALANCE=10000.00
SMA_PERIOD=4750
BAND_POINTS=50
QUANTITY=1
MNQ_QUANTITY=1
COMMISSION_PER_SIDE=0.62
SLIPPAGE_TICKS=1

# Persistence — Railway volume MUST mount at /data
# Local default: data/paper_trading.db
# Railway:       /data/trading.db
DATABASE_PATH=data/paper_trading.db
LOG_DIR=logs
REPORTS_DIR=reports

# Timezones
# Internal timestamps are ALWAYS UTC.
# Dashboard display timezone:
TZ_DISPLAY=America/Argentina/Cordoba

# API / dashboard
# Railway injects PORT. Local default 8010.
API_HOST=0.0.0.0
API_PORT=8010
FRONTEND_PORT=5173

# Engine
BARS_REQUIRED_TO_TRADE=4750
EXIT_ON_SESSION_CLOSE=true
EXIT_ON_SESSION_CLOSE_SECONDS=30
ENGINE_POLL_SECONDS=5
FORWARD_TEST_ENABLED=true
STALE_AFTER_SECONDS=180
EMBED_WORKER=true
WORKER_LEASE_TTL_SECONDS=45

# Sanity check year (reference only — not used to optimize)
SANITY_CHECK_YEAR=2024
